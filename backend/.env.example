# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=valor_db
DB_USER=postgres
DB_PASSWORD=your_password

# Redis (Memurai on Windows)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MSG91 OTP
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=VALOR

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_master_key

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Platform Settings
PLATFORM_COMMISSION_FREE=0.10
PLATFORM_COMMISSION_SILVER=0.08
PLATFORM_COMMISSION_GOLD=0.06
PLATFORM_COMMISSION_PLATINUM=0.04
ESCROW_RELEASE_DAYS=7
MIN_WITHDRAWAL=500
REFERRAL_REWARD_REFERRER=200
REFERRAL_REWARD_REFEREE=100
